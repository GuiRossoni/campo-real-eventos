# Application Environment
NODE_ENV=production
PORT=3000

# Security & Authentication (Generate a strong 32+ character random string for production)
JWT_SECRET=your_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Policy (Set to your production domain, e.g. https://eventos.camporeal.edu.br)
CORS_ORIGIN=*

# MySQL Database Configuration (Hostinger Database details)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_camporeal
DB_PASSWORD=your_secure_db_password
DB_NAME=u123456789_eventos

# Institutional SMTP Configuration (Managed server-side, never exposed to clients)
SMTP_HOST=smtp.camporeal.edu.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificacoes.eventos@camporeal.edu.br
SMTP_PASS=your_smtp_password_here
SMTP_FROM_NAME="Campo Real Eventos"
SMTP_FROM_EMAIL=notificacoes.eventos@camporeal.edu.br
SMTP_REPLY_TO=suporte.eventos@camporeal.edu.br

# Uploads Configuration
MAX_UPLOAD_SIZE_MB=10

